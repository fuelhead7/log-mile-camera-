{
  "expo": {
    "name": "LogMile Camera",
    "slug": "logmile-camera-rebuild",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "logmilecamera-rebuild",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.logmile.camera.rebuild",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.logmile.camera.rebuild"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "recordAudioAndroid": false,
          "cameraPermission": "Capture roadway inspection photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tag inspection photos with your current roadway location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose inspection photos to import.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
